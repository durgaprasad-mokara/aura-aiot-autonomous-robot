# ==========================================
# AURA — AIoT Autonomous Robotics Platform
# Environment Variables
# ==========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==========================================

# ----- Application -----
APP_NAME=AURA
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ----- Backend -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ----- Database (PostgreSQL) -----
POSTGRES_USER=aura
POSTGRES_PASSWORD=changeme_db_password
POSTGRES_DB=aura_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aura:changeme_db_password@postgres:5432/aura_db

# ----- Authentication -----
JWT_SECRET=changeme_jwt_secret_min_32_chars_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- MQTT (Mosquitto) -----
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_USERNAME=aura_mqtt
MQTT_PASSWORD=changeme_mqtt_password
MQTT_CLIENT_ID=aura-backend

# ----- AI / Computer Vision -----
AI_MODEL_PATH=./ai/models
AI_CONFIDENCE_THRESHOLD=0.5
AI_API_KEY=changeme_ai_api_key

# ----- Camera -----
CAMERA_URL=
CAMERA_MOCK=true

# ----- Robot Defaults -----
ROBOT_HEARTBEAT_INTERVAL=5
ROBOT_HEARTBEAT_TIMEOUT=15
ROBOT_MIN_SAFE_DISTANCE=20
ROBOT_CRITICAL_BATTERY=10
ROBOT_LOW_BATTERY=20
ROBOT_CRITICAL_GAS_LEVEL=50
ROBOT_CRITICAL_TEMPERATURE=60

# ----- Simulator -----
SIMULATOR_ENABLED=true
SIMULATOR_ROBOT_ID=AURA-001
SIMULATOR_MODE=NORMAL
SIMULATOR_TICK_RATE=1.0

# ----- Redis (optional, for caching/rate limiting) -----
# REDIS_URL=redis://redis:6379/0

# ----- Frontend -----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MQTT_WS_URL=ws://localhost:9001
